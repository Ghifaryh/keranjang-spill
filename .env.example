# ==========================================
# KeranjangSpill Environment Configuration
# ==========================================

# Base application URL (used for links in Telegram replies)
APP_URL=https://spill.yourdomain.com

# Server configuration
HOST=0.0.0.0
PORT=4321
DATABASE_PATH=./data/keranjang.db

# ------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------
# Telegram Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram numeric user ID (obtained from @userinfobot)
# Only this user can add/edit/delete products. Others receive 403 Forbidden.
TELEGRAM_ALLOWED_USER_ID=987654321

# Optional secret token sent in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=your_random_secret_token_here

# ------------------------------------------
# Google Sheets Configuration (CMS Backup)
# ------------------------------------------
# The Google Sheet ID from the URL (e.g., https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# Google Cloud Service Account JSON credentials (can be raw JSON or Base64 encoded JSON)
GOOGLE_SERVICE_ACCOUNT_KEY=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6Ii4uLiJ9

# Optional secret for manual /api/sync endpoint trigger
SYNC_SECRET=super_secret_sync_key

# ------------------------------------------
# Creator Profile Customization (Frontend)
# ------------------------------------------
CREATOR_NAME=Spill by Intan 🌸
CREATOR_BIO=Rekomendasi outfit, skincare & printilan lucu! Cari nomor spill dari video TikTok/IG kamu di bawah ya ✨
CREATOR_AVATAR=https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop&q=80
CREATOR_TIKTOK=https://tiktok.com/@creator
CREATOR_INSTAGRAM=https://instagram.com/creator
